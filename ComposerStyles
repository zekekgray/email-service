<!-- === START: COMPOSER STYLES === -->
<style>
  :root { --sand:#ECE4D6; --ink:#0B0B0B; --gold:#C9A24B; --line:#E2D9C6; }
  * { box-sizing:border-box; }
  html,body { margin:0; height:100%; background:var(--sand);
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif; color:var(--ink); }
  .app { display:grid; grid-template-columns:minmax(320px,400px) minmax(0,1fr); gap:14px; height:100%; padding:14px; }
  .pane { background:#fff; border-radius:22px; overflow:hidden; }
  .form { padding:20px; overflow:auto; }
  .brand { font-family:Georgia,serif; letter-spacing:6px; font-size:15px; margin-bottom:16px; }
  .brand span { color:var(--gold); letter-spacing:4px; font-size:11px; }
  label { display:block; font-size:12px; font-weight:600; color:#444; margin-bottom:12px; }
  label em { font-weight:400; color:#767676; font-style:normal; }
  input,textarea { display:block; width:100%; margin-top:5px; padding:10px 12px; font:inherit; font-size:14px;
    border:1px solid var(--line); border-radius:12px; background:#FBF8F2; color:var(--ink); outline:none; resize:vertical; }
  input:focus,textarea:focus { border-color:var(--gold); background:#fff; }
  .row { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .stats { font-family:'Courier New',monospace; font-size:11px; color:#6E6858; margin:6px 0 12px; }
  .actions { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
  button { font:inherit; font-size:13px; font-weight:600; padding:12px; border-radius:999px; border:0; cursor:pointer; }
  button:disabled { opacity:.45; cursor:default; }
  .ghost { background:#F3EEE3; color:var(--ink); }
  .solid { background:var(--ink); color:#fff; }
  .gold  { background:var(--gold); color:var(--ink); }
  .preview { display:flex; flex-direction:column; background:#D9D0BD; }
  .bar { display:flex; justify-content:space-between; align-items:center; padding:12px 16px;
    font-family:'Courier New',monospace; font-size:11px; letter-spacing:3px; color:#4F4A3D; }
  .seg { display:flex; gap:4px; }
  .seg button { padding:6px 14px; font-size:11px; background:transparent; color:#4F4A3D; }
  .seg button.on { background:#fff; color:var(--ink); }
  .stage { flex:1; display:flex; justify-content:center; padding:0 14px 14px; min-height:0; }
  iframe { height:100%; min-height:320px; width:100%; max-width:660px; border:0; border-radius:16px; background:#ECE4D6; transition:max-width .25s; }
  iframe.mobile { max-width:390px; }
  #toast { position:fixed; left:50%; bottom:22px; transform:translateX(-50%) translateY(20px); opacity:0;
    background:var(--ink); color:#fff; padding:11px 20px; border-radius:999px; font-size:13px;
    width:max-content; max-width:calc(100vw - 32px); text-align:center;
    transition:all .25s; pointer-events:none; }
  #toast.show { opacity:1; transform:translateX(-50%) translateY(0); }
  #toast.err { background:#B3261E; }

  /* === START: COMPOSER STATES EDIT === */
  button:not(:disabled):hover { filter:brightness(.94); }
  button:not(:disabled):active { transform:scale(.97); }
  input:invalid:not(:placeholder-shown) { border-color:#B3261E; }
  /* === END: COMPOSER STATES EDIT === */

  /* CS03: keyboard-visible focus */
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible { outline:3px solid var(--gold); outline-offset:2px; }
  .solid:focus-visible { outline-color:var(--ink); box-shadow:0 0 0 2px #fff; }

  /* CS02: maliit na dialog / mobile */
  @media (max-width:760px) {
    html,body { height:auto; min-height:100%; }
    .app { grid-template-columns:1fr; height:auto; }
    .form { overflow:visible; }
    .preview { min-height:520px; }
    .seg button { padding:10px 16px; }
  }

  /* CS06: reduced motion */
  @media (prefers-reduced-motion:reduce) {
    iframe, #toast { transition:none; }
  }
</style>
<!-- === END: COMPOSER STYLES === -->
