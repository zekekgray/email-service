// Idempotent: safe to run again. Never overwrites existing headers, data or the Message sheet.
function setupArtiMail() {
  requireAdmin_();
  var ss = SpreadsheetApp.getActive();

  var subs = ss.getSheetByName(CFG.SHEET_SUBS) || ss.insertSheet(CFG.SHEET_SUBS);
  if (!subs.getRange('A1').getValue()) {
    subs.getRange(1, 1, 1, 6).setValues([['Name', 'Number', 'Email', 'Status', 'Last Sent', 'Token']])
      .setFontWeight('bold').setBackground('#111111').setFontColor('#FFFFFF');
    subs.setFrozenRows(1);
    subs.setColumnWidths(1, 6, 180);
  }
  subs.getRange('B:B').setNumberFormat('@');            // keeps leading 0 / +63
  subs.getRange('E:E').setNumberFormat('yyyy-mm-dd hh:mm');
  subs.getRange('D2:D').setDataValidation(
    SpreadsheetApp.newDataValidation().requireValueInList(CFG.STATUS_LIST, true).setAllowInvalid(false).build());

  var msg = ss.getSheetByName(CFG.SHEET_MSG) || ss.insertSheet(CFG.SHEET_MSG);
  if (!msg.getRange('A1').getValue()) {
    msg.getRange('A1:B8').setValues([
      ['Subject', 'Introducing ArtiBytte — built for Philippine business'],
      ['Label (ANNOUNCEMENT / NEW PRODUCT)', 'ANNOUNCEMENT'],
      ['Headline', 'Smarter systems for growing businesses.'],
      ['Body (blank line = new paragraph)', 'We build specialized business systems on one shared foundation.\n\nThis update shares what is new and what is coming next.'],
      ['Image URL (optional, https)', ''],
      ['Button label', 'Learn more'],
      ['Button link', CFG.WEBSITE],
      ['Preview text', 'What is new at ArtiBytte Inc.']
    ]);
    msg.getRange('A1:A8').setFontWeight('bold');
    msg.setColumnWidth(1, 260); msg.setColumnWidth(2, 560);
    msg.getRange('B1:B8').setWrap(true).setVerticalAlignment('top');
  }

  opSheet_(CFG.SHEET_LOG, LOG_HEADERS);
  opSheet_(CFG.SHEET_CAMPAIGNS, CAMPAIGN_HEADERS);
  opSheet_(CFG.SHEET_AUDIT, AUDIT_HEADERS);
  opSheet_(CFG.SHEET_SUPP, SUPP_HEADERS);

  // Create the trigger only if it does not exist; remove accidental duplicates.
  var existing = ScriptApp.getProjectTriggers().filter(function (t) { return t.getHandlerFunction() === 'onEditSend'; });
  existing.slice(1).forEach(function (t) { ScriptApp.deleteTrigger(t); });
  if (!existing.length) ScriptApp.newTrigger('onEditSend').forSpreadsheet(ss).onEdit().create();

  audit_('SETUP', 'trigger ' + (existing.length ? 'already present' : 'created'));
  SpreadsheetApp.getUi().alert('ArtiBytte Mail is ready. Edit the "Message" sheet, then add emails to "Subscribers".');
}
