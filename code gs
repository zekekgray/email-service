// Fills "Last Sent" for anyone the ledger says was sent but the sheet missed (e.g. a failed sheet write).
function reconcileSendLog() {
  var ui = SpreadsheetApp.getUi();
  try {
    var user = requireAdmin_();
    var fixed = withLock_(30000, function () {
      var log = opSheet_(CFG.SHEET_LOG, LOG_HEADERS), last = log.getLastRow();
      if (last < 2) return 0;
      var latest = {};
      log.getRange(2, 1, last - 1, 4).getValues().forEach(function (v) {
        if (v[3] === 'SENT' && String(v[0]).indexOf('AUTO') !== 0 || v[3] === 'SENT') {
          var e = String(v[2]).toLowerCase();
          if (!latest[e] || v[1] > latest[e]) latest[e] = v[1];
        }
      });
      var sh = sheet_(CFG.SHEET_SUBS), c = CFG.COL, n = 0;
      readSubs_(sh).forEach(function (s) {
        var e = s.email.toLowerCase();
        if (!s.last && latest[e]) { sh.getRange(s.row, c.LAST_SENT).setValue(latest[e]); n++; }
      });
      return n;
    });
    audit_('RECONCILE', 'rows fixed: ' + fixed, user);
    ui.alert('Reconciled. Rows corrected: ' + fixed);
  } catch (e) { ui.alert('Reconcile failed: ' + e.message); }
}

