// GET only SHOWS a confirmation button. The state change happens in unsubscribeConfirm(),
// so email security scanners that open links cannot unsubscribe people by accident.
function doGet(e) {
  try {
    var token = String((e && e.parameter && e.parameter.token) || '');
    if (!/^[A-Za-z0-9-]{8,64}$/.test(token)) {
      return page_('Link not valid', '<p style="color:#555;line-height:1.6;margin:0">This link is invalid or expired. You can also reply to any of our emails to unsubscribe.</p>');
    }
    return page_('Unsubscribe?',
      '<p id="m" style="color:#555;line-height:1.6;margin:0 0 20px">Confirm that you no longer want to receive emails from ' + esc_(CFG.BRAND) + '.</p>' +
      '<button id="b" style="background:#111;color:#fff;border:0;border-radius:999px;padding:14px 28px;font-size:15px;cursor:pointer">Yes, unsubscribe me</button>' +
      '<script>' +
      'var T=' + JSON.stringify(token) + ';' +
      'document.getElementById("b").onclick=function(){var b=this;b.disabled=true;b.textContent="Please wait...";' +
      'google.script.run.withSuccessHandler(function(ok){' +
      'document.getElementById("t").textContent=ok?"You have been unsubscribed":"Link not valid";' +
      'document.getElementById("m").textContent=ok?"You will no longer receive emails from ' + esc_(CFG.BRAND) + '.":"This link is invalid or expired.";' +
      'b.style.display="none";}).withFailureHandler(function(){b.disabled=false;b.textContent="Try again";})' +
      '.unsubscribeConfirm(T);};' +
      '</script>');
  } catch (err) {
    audit_('UNSUB_PAGE_ERROR', err.message, 'recipient');
    return page_('Something went wrong', '<p style="color:#555;line-height:1.6;margin:0">Please reply to our email and we will remove you manually.</p>');
  }
}

// Public on purpose (called by the confirmation page). Token-only, rate limited, audited.
function unsubscribeConfirm(token) {
  token = String(token || '');
  if (!/^[A-Za-z0-9-]{8,64}$/.test(token)) return false;

  var cache = CacheService.getScriptCache();
  var n = Number(cache.get('unsub_n') || 0);
  if (n > 120) throw new Error('Too many requests. Try again in a minute.');
  cache.put('unsub_n', String(n + 1), 60);

  return withLock_(15000, function () {
    var sh = sheet_(CFG.SHEET_SUBS), c = CFG.COL, subs = readSubs_(sh);
    var hits = subs.filter(function (s) { return s.token === token; });
    if (!hits.length) { audit_('UNSUBSCRIBE', 'token not found', 'recipient'); return false; }

    var emails = {};
    hits.forEach(function (s) { emails[s.email.toLowerCase()] = true; });
    if (Object.keys(emails).length > 1) {      // ambiguous token: refuse rather than hit the wrong person
      audit_('UNSUBSCRIBE', 'ambiguous token, ' + Object.keys(emails).length + ' addresses', 'recipient');
      return false;
    }
    var email = Object.keys(emails)[0];
    subs.forEach(function (s) {
      if (s.email.toLowerCase() === email) sh.getRange(s.row, c.STATUS).setValue('Unsubscribed');
    });
    suppress_(email, 'Unsubscribed via link');
    audit_('UNSUBSCRIBE', email.replace(/^(.).*(@.*)$/, '$1***$2'), 'recipient');
    return true;
  });
}
