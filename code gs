function summarize_(r) {
  if (r.state === 'EMPTY') return 'No recipients to send to.';
  if (r.state === 'NOTHING_TO_RESUME') return 'No interrupted campaign to resume.';
  return 'Campaign ' + (r.campaignId || '') + ': ' + r.state + '\nSent: ' + r.sent + '\nFailed: ' + r.failed +
    (r.remaining ? '\nRemaining: ' + r.remaining + ' (use "Resume interrupted campaign")' : '') +
    '\n\nDetails are in the "SendLog" sheet.';
}

function broadcast_(onlyNew) {
  var ui = SpreadsheetApp.getUi();
  try {
    requireAdmin_();
    var n = normalizeMessage_(readMessage_());
    if (n.errors.length) { ui.alert('Fix the "Message" sheet first:\n\n' + n.errors.join('\n')); return; }

    var t = buildTargets_(sheet_(CFG.SHEET_SUBS), onlyNew);
    if (!t.rows.length) { ui.alert('No recipients to send to.'); return; }

    var quota = MailApp.getRemainingDailyQuota();
    var note = '\n\nSkipped: ' + t.skipped.duplicate + ' duplicate, ' + t.skipped.suppressed + ' suppressed/unsubscribed, ' +
      t.skipped.invalid + ' invalid.' +
      (t.rows.length > quota - CFG.QUOTA_RESERVE ? '\n\nQuota left today: ' + quota + '. The send will pause and can be resumed.' : '');
    var go = ui.alert('Send "' + n.msg.subject + '" to ' + t.rows.length + ' people?' + note, ui.ButtonSet.YES_NO);
    if (go !== ui.Button.YES) return;

    ui.alert(summarize_(startCampaign_(n.msg, onlyNew ? 'new' : 'all')));
  } catch (e) {
    ui.alert('Not sent: ' + e.message);
  }
}

